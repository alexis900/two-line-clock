<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="two-line-clock">

  <schema id="org.gnome.shell.extensions.two-line-clock"
          path="/org/gnome/shell/extensions/two-line-clock/">

    <key name="clock-format" type="s">
      <choices>
        <choice value="system"/>
        <choice value="24h"/>
        <choice value="12h"/>
      </choices>
      <default>'system'</default>
      <summary>Clock format</summary>
      <description>Follow the system format, force 24 hours or force 12 hours.</description>
    </key>

    <key name="show-seconds" type="b">
      <default>false</default>
      <summary>Show seconds</summary>
      <description>Include seconds in the time.</description>
    </key>

    <key name="time-font-size" type="i">
      <range min="6" max="24"/>
      <default>11</default>
      <summary>Time size</summary>
      <description>Size of the time in points.</description>
    </key>

    <key name="time-weight" type="s">
      <choices>
        <choice value="normal"/>
        <choice value="medium"/>
        <choice value="semibold"/>
        <choice value="bold"/>
      </choices>
      <default>'semibold'</default>
      <summary>Time weight</summary>
      <description>Font weight of the time.</description>
    </key>

    <key name="time-color" type="s">
      <default>''</default>
      <summary>Time color</summary>
      <description>Color of the time as #rrggbb. Empty uses the theme color.</description>
    </key>

    <key name="show-date" type="b">
      <default>true</default>
      <summary>Show date</summary>
      <description>Show the date on a second line.</description>
    </key>

    <key name="date-font-size" type="i">
      <range min="5" max="18"/>
      <default>8</default>
      <summary>Date size</summary>
      <description>Size of the date in points.</description>
    </key>

    <key name="date-opacity" type="i">
      <range min="20" max="100"/>
      <default>75</default>
      <summary>Date opacity</summary>
      <description>Opacity of the date as a percentage.</description>
    </key>

    <key name="date-color" type="s">
      <default>''</default>
      <summary>Date color</summary>
      <description>Color of the date as #rrggbb. Empty uses the theme color.</description>
    </key>

    <key name="date-format" type="s">
      <default>'%d/%m/%Y'</default>
      <summary>Date format</summary>
      <description>Date format using the GLib.DateTime.format() syntax.</description>
    </key>

  </schema>
</schemalist>
